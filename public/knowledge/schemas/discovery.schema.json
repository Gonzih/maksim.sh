{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maksim.sh/knowledge/schemas/discovery.schema.json",
  "title": "maksim.sh Machine Discovery Index",
  "type": "object",
  "required": ["$schema", "id", "type", "version", "updated", "canonical", "counts", "entrypoints", "aliases", "capabilities"],
  "properties": {
    "$schema": { "const": "https://maksim.sh/knowledge/schemas/discovery.schema.json" },
    "id": { "const": "https://maksim.sh/index.json" },
    "type": { "const": "MachineDiscoveryIndex" },
    "version": { "type": "string" },
    "updated": { "type": "string", "format": "date" },
    "canonical": { "const": "https://maksim.sh/" },
    "generated_by": { "type": "string" },
    "counts": { "type": "object" },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rel", "url", "media_type", "purpose"],
        "properties": {
          "rel": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "media_type": { "type": "string" },
          "purpose": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "aliases": { "type": "object" },
    "capabilities": { "type": "object" }
  },
  "additionalProperties": false
}
